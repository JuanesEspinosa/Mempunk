{
  "name": "mempunk",
  "version": "2.0.2",
  "description": "Persistent dev brain for AI coding CLIs (Claude Code, opencode, gemini-cli) — memory vault across sessions",
  "type": "module",
  "bin": {
    "mempunk": "src/cli.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "keywords": [
    "claude-code",
    "opencode",
    "gemini-cli",
    "memory",
    "dev-brain",
    "obsidian",
    "ai-context"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanesEspinosa/Mempunk.git"
  },
  "files": [
    "src/",
    "templates/"
  ],
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  }
}
