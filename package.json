{
  "name": "mempunk",
  "version": "2.1.0",
  "description": "Persistent dev brain for AI coding CLIs (Claude Code, opencode, gemini-cli) — memory vault across sessions",
  "type": "module",
  "bin": {
    "mempunk": "src/cli.js"
  },
  "scripts": {
    "build": "node scripts/build-hooks.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "c8 --include \"src/**\" --reporter text --reporter lcov --check-coverage --lines 80 node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "lint": "eslint src tests scripts eslint.config.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "keywords": [
    "claude-code",
    "opencode",
    "gemini-cli",
    "memory",
    "dev-brain",
    "obsidian",
    "ai-context"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanesEspinosa/Mempunk.git"
  },
  "files": [
    "src/",
    "dist/",
    "templates/",
    "scripts/"
  ],
  "dependencies": {
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^11.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2"
  }
}
